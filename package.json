{
  "name": "dsh-tool-graphic-chain",
  "version": "0.2.0",
  "description": "可视化图形调用链：把 Think 与连续工具调用压成一条横向胶囊链，模型说话才截断。纯净，不做多余的事。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tool-call",
    "pipeline",
    "visualization",
    "web-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NormanFxxkingRockwell/dsh-tool-graphic-chain.git"
  },
  "homepage": "https://github.com/NormanFxxkingRockwell/dsh-tool-graphic-chain#readme",
  "bugs": {
    "url": "https://github.com/NormanFxxkingRockwell/dsh-tool-graphic-chain/issues"
  },
  "author": "NormanFxxkingRockwell",
  "license": "MIT",
  "scripts": {
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "jsdom": "^24.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}